<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
	</array>
	<key>BeayyAmapKey</key>
	<string>$(BEAYY_AMAP_KEY)</string>
	<key>BeayyDeviceID</key>
	<string>$(BEAYY_DEVICE_ID)</string>
	<key>CFBundleDisplayName</key>
	<string>Beayy</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSHealthShareUsageDescription</key>
	<string>读苹果健康里的数据（睡眠、步数、锻炼、心率、心情等），加密后同步到你自己的电脑，放进每天的记录和总结。只读，不写。</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Beayy 不往健康里写数据。</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>选「始终允许」才能在不打开 app 时记下停留点。只记停留的地方，不记路上的轨迹。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>记下你在哪些地方停留过（到达、离开时间和地点），用来统计在家、在公司、在外面各多久，并给对话标上地点。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>全天录音（没戴手表时用 iPhone 录），转成文字后记进你的人生记录；也用来录一段声纹认出你。</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
